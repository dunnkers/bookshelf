<!-- bookshelf-bookshelf.hbs -->
<div class="kg-width-wide">
    <h2 class="bookshelf-shelf-header">Currently reading</h2>
    <div class="bookshelf-shelf">
    {{#each current}}
        <p class="bookshelf-book">
            <figure>
                <img src="{{image_url}}" alt="{{title}} Cover" />
                <figcaption><a href="{{link}}" target="_blank" rel="noopener">{{title}}</a></figcaption>
                <figcaption class="author">{{author}}</figcaption>
            </figure>
        </p>
    {{/each}}
    </div>
    <h2 class="bookshelf-shelf-header">Read</h2>
    <div class="bookshelf-shelf">
    {{#each read}}
        <div class="bookshelf-book">
            <figure>

                <img src="{{image_url}}" alt="{{title}} Cover" />

                <figcaption class="title"><a href="{{link}}" target="_blank" rel="noopener">{{title}}</a></figcaption>
                <figcaption class="author">{{author}}</figcaption>
            </figure>
        </div>
    {{/each}}
    </div>
</div>